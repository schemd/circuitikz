{
  "name": "@schemd/circuitikz",
  "version": "0.0.0",
  "description": "Convert a strict subset of CircuiTikZ into schemd source, preserving circuit topology.",
  "homepage": "https://schemd.johnowolabiidogun.dev",
  "bugs": {
    "url": "https://github.com/schemd/circuitikz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemd/circuitikz.git"
  },
  "author": {
    "name": "John Owolabi Idogun",
    "url": "https://www.johnowolabiidogun.dev"
  },
  "packageManager": "bun@1.4.3",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\" && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build",
    "release:check": "bun run check && bun run test:coverage && bun run test:mutation && bun run build && bun run size",
    "size": "node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "node scripts/mutation.mjs"
  },
  "peerDependencies": {
    "@schemd/core": "^1.3.1"
  },
  "devDependencies": {
    "@schemd/core": "^1.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "schemd",
    "circuitikz",
    "tikz",
    "latex",
    "schematic",
    "converter"
  ],
  "license": "MIT"
}
